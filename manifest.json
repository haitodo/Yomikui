{
  "name": "__MSG_appName__",
  "version": "0.1.0",
  "manifest_version": 3,
  "default_locale": "ja",
  "description": "__MSG_appDescription__",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png"
  },
  "permissions": [
    "storage",
    "webRequest",
    "declarativeNetRequest",
    "contextMenus",
    "downloads"
  ],
  "host_permissions": [
    "*://twitter.com/*",
    "*://*.twitter.com/*",
    "*://x.com/*",
    "*://*.x.com/*",
    "*://*.twimg.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "deck",
        "enabled": true,
        "path": "deckRules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/yomikui*",
        "https://*.twitter.com/yomikui*",
        "https://x.com/yomikui*",
        "https://*.x.com/yomikui*"
      ],
      "js": [
        "columnLayout.js",
        "columnNavigation.js",
        "tweetActions.js",
        "tweetRouting.js",
        "homeScroll.js",
        "floatingControls.js",
        "homeRefresh.js",
        "mediaPip.js",
        "searchFilters.js",
        "contentDeck.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://twitter.com/*",
        "https://*.twitter.com/*",
        "https://x.com/*",
        "https://*.x.com/*"
      ],
      "js": [
        "frameMaintenance.js",
        "columnNavigation.js",
        "tweetActions.js",
        "tweetRouting.js",
        "homeScroll.js",
        "refreshBoundary.js",
        "homeRefresh.js",
        "wideMedia.js",
        "mediaPipFrame.js",
        "searchFilters.js",
        "contentIframe.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://twitter.com/*",
        "https://*.twitter.com/*",
        "https://x.com/*",
        "https://*.x.com/*"
      ],
      "js": [
        "nativeTimeline.js",
        "mediaInterceptor.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://*.twitter.com/*",
        "https://x.com/*",
        "https://*.x.com/*"
      ],
      "resources": [
        "icons/*",
        "mediaInterceptor.js",
        "tweetActions.js"
      ]
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "64": "icons/icon64.png",
      "128": "icons/icon128.png",
      "256": "icons/icon256.png"
    }
  },
  "key": ""
}
